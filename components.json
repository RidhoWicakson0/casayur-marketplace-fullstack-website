{
    "$schema": "https://ui.shadcn.com/schema.json",
    "style": "new-york",
    "rsc": false,
    "tsx": true,
    "tailwind": {
        "config": "",
        "css": "resources/css/app.css",
        "baseColor": "neutral",
        "cssVariables": true,
        "prefix": ""
    },
    "aliases": {
        "components": "@/components",
        "utils": "@/lib/utils",
        "ui": "@/components/ui",
        "lib": "@/lib",
        "hooks": "@/hooks"
    },
    "iconLibrary": "lucide",
    "registries": {
        "@reactbits-starter": {
            "url": "https://registry.reactbits.dev/{name}.json",
            "headers": {
                "Authorization": "Bearer ${REACTBITS_LICENSE_KEY}"
            }
        },
        "@reactbits-pro": {
            "url": "https://registry.reactbits.dev/pro/{name}.json",
            "headers": {
                "Authorization": "Bearer ${REACTBITS_LICENSE_KEY}"
            }
        }
    }
}
